meta {
  name: 01 - Login (guarda ambos tokens)
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/auth/login
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "email": "usuario@test.com",
    "password": "Test1234"
  }
}

script:post-response {
  if (res.body && res.body.token) {
    bru.setEnvVar("authToken", res.body.token);
  }
  if (res.body && res.body.refreshToken) {
    bru.setEnvVar("refreshToken", res.body.refreshToken);
    // Copia congelada del PRIMER refresh token, para el paso de "reusar el viejo".
    bru.setEnvVar("oldRefreshToken", res.body.refreshToken);
  }
}
