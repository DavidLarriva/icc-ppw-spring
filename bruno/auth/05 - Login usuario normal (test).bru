meta {
  name: 05 - Login usuario normal (test)
  type: http
  seq: 5
}

post {
  url: {{baseUrl}}/auth/login
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "email": "usuario@test.com",
    "password": "Test1234"
  }
}

script:post-response {
  if (res.body && res.body.token) {
    bru.setEnvVar("authToken", res.body.token);
  }
}
