meta {
  name: 01 - Register
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/auth/register
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "name": "Ana Torres",
    "email": "ana@example.com",
    "password": "Secret123"
  }
}

script:post-response {
  if (res.body && res.body.token) {
    bru.setEnvVar("authToken", res.body.token);
  }
}
